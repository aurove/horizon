# Copy this file to .env in the Horizon workspace root. The deployment script
# reads it automatically; variables exported in the shell take precedence.

# Shared signer for Mezo, Base / Base Sepolia, and NTT configuration.
ETH_PRIVATE_KEY=

# Required positive daily limits for each 18-decimal vault share.
HORIZON_AVBTCV_NTT_LIMIT=
HORIZON_AVMEZOV_NTT_LIMIT=

# Required for Base/Base Sepolia source verification (one Basescan API key works for both).
BASESCAN_API_KEY=

# Required confirmations before deployment.
CONFIRM_HORIZON_DEPLOYMENT=
CONFIRM_HORIZON_MAINNET_DEPLOYMENT=

# Required only for the destructive fresh-redeployment workflow.
CONFIRM_HORIZON_REDEPLOYMENT=

# Optional: set YES to skip public explorer source verification during NTT manager deployment.
HORIZON_SKIP_NTT_VERIFY=

# Optional: set YES to reuse existing contract deployment records when resuming NTT setup.
HORIZON_SKIP_CONTRACT_DEPLOYMENT=

# Chain RPC settings shared by the root orchestrator and both submodules.
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
# Required for mainnet deployment and verification.
MEZO_MAINNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Required only after reviewing the amount for the Mezo testnet ↔ Base Sepolia round trip.
CONFIRM_HORIZON_TESTNET_ROUNDTRIP=
# Dedicated signer for testnet round trips; the script passes it to the NTT CLI as ETH_PRIVATE_KEY.
HORIZON_ROUNDTRIP_PRIVATE_KEY=
# Optional destination observation / transfer timeout in seconds (120–14400, default 3600).
HORIZON_ROUNDTRIP_TIMEOUT_SECONDS=3600

# Wave 2 E2E (scripts/e2e-horizon-aero.ts): deposit? → NTT Mezo→Base → Aero swap + LP.
# Default is dry-run (no txs). Live broadcast requires both of the following:
# CONFIRM_HORIZON_E2E=YES
# HORIZON_E2E_PRIVATE_KEY=
# Optional: E2E_DEPOSIT_ASSETS=0.01  E2E_SWAP_BPS=5000  E2E_SKIP_BRIDGE=YES
# HORIZON_E2E_TIMEOUT_SECONDS=3600

# Mezo testnet is also the default Hardhat fork target; optionally override it with FORK_RPC_URL.

# Optional: after cross-chain testnet deploy, also run aero Slipstream + DemoMUSD + pool create
# (non-fatal if keys missing or broadcast fails). Scripts stay ready without this flag.
# HORIZON_RUN_AERO=YES

# Optional Base Sepolia MUSD override (default: DemoMUSD from aero address book).
# Canonical mainnet MUSD is 0xdD468A1DDc392dcdbEf6db6e34E89AA338F9F186 (not on Base Sepolia).
# MUSD_ADDRESS=

# Optional LP seed sizes for aero/scripts/seed-horizon-lp.ts (ether units).
# SEED_AMOUNT_SHARE=0.01
# SEED_AMOUNT_MUSD=0.01
