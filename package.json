{
  "name": "@aurove/horizon",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @aurove/horizon-contracts build",
    "test": "pnpm --filter @aurove/horizon-contracts test",
    "compile": "pnpm --filter @aurove/horizon-contracts compile",
    "clean": "pnpm --filter @aurove/horizon-contracts clean",
    "typecheck": "pnpm --filter @aurove/horizon-contracts typecheck && pnpm --filter @aurove/horizon-wormhole typecheck && pnpm --filter @aurove/horizon-aero typecheck",
    "ntt:commands": "pnpm --filter @aurove/horizon-wormhole exec tsx scripts/print-add-chain-commands.ts",
    "ntt:install": "pnpm --filter @aurove/horizon-wormhole ntt:install",
    "ntt:init": "pnpm --filter @aurove/horizon-wormhole ntt:init",
    "ntt:deploy": "pnpm --filter @aurove/horizon-wormhole ntt:deploy",
    "deploy:cross-chain:testnet": "node scripts/deploy-horizon.mjs testnet",
    "deploy:cross-chain:mainnet": "node scripts/deploy-horizon.mjs mainnet",
    "redeploy:cross-chain:testnet": "node scripts/deploy-horizon.mjs testnet --reset",
    "redeploy:cross-chain:mainnet": "node scripts/deploy-horizon.mjs mainnet --reset",
    "verify:cross-chain:testnet": "node scripts/verify-horizon.mjs testnet",
    "verify:cross-chain:mainnet": "node scripts/verify-horizon.mjs mainnet",
    "bridge:roundtrip:testnet": "pnpm --filter @aurove/horizon-wormhole exec node --import tsx ../scripts/bridge-roundtrip.ts",
    "compile:aero": "pnpm --filter @aurove/horizon-aero compile",
    "deploy:slipstream:base-sepolia": "pnpm --filter @aurove/horizon-aero deploy:slipstream:base-sepolia",
    "deploy:slipstream:base-sepolia:broadcast": "pnpm --filter @aurove/horizon-aero deploy:slipstream:base-sepolia:broadcast",
    "deploy:demo-musd": "pnpm --filter @aurove/horizon-aero deploy:demo-musd",
    "deploy:demo-musd:broadcast": "pnpm --filter @aurove/horizon-aero deploy:demo-musd:broadcast",
    "create:horizon-pools": "pnpm --filter @aurove/horizon-aero create:horizon-pools",
    "create:horizon-pools:broadcast": "pnpm --filter @aurove/horizon-aero create:horizon-pools:broadcast",
    "seed:horizon-lp": "pnpm --filter @aurove/horizon-aero seed:horizon-lp",
    "seed:horizon-lp:broadcast": "pnpm --filter @aurove/horizon-aero seed:horizon-lp:broadcast"
  }
}
